# Server only. Copy to .env locally and load with Node --env-file=.env.
# Never paste real keys into source, browser storage, or a Git commit.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
# Official SiliconFlow model ID, verified against GET /models at runtime.
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash
QUIZ_AI_TIMEOUT_MS=60000
# Separate random administrator secret, NOT your provider API Key.
QUIZ_ADMIN_TOKEN=
